# Copy to .env and adjust if needed. Matches docker-compose.yml at repo root.
DATABASE_URL="postgresql://resume_saas:resume_saas@localhost:5432/resume_saas?schema=public"

# --- Firebase Auth ---
# From Firebase console > Project settings > General > Your apps (Web app).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# From Firebase console > Project settings > Service accounts > Generate new private key.
# Paste the downloaded JSON's contents as a single-line string.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- API key encryption at rest (AES-256-GCM) ---
# Generate your own: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- Gemini ---
GEMINI_MODEL=gemini-flash-latest
